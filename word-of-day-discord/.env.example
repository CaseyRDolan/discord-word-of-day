# Required: paste the webhook URL from Discord here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Optional settings.
WOTD_TIMEZONE=America/New_York
WOTD_USERNAME=Word of the Day
WOTD_EMBED_COLOR=3BA55D
WOTD_SOURCE=merriam-webster
WOTD_INTRO_TEXT=Wordussies, today's word has dropped.
WOTD_CHALLENGE_TEXT=Use **{word}** in a sentence at some point today.

# Optional: set this to 0 if you want the script to fail instead of using
# words.json when Merriam-Webster cannot be reached.
WOTD_ALLOW_LOCAL_FALLBACK=1

# Optional: mention a role when posting. Use the numeric Discord role ID.
# WOTD_ROLE_ID=123456789012345678

# Optional: set an avatar image for the webhook sender.
# WOTD_AVATAR_URL=https://example.com/avatar.png

# Optional: random vanishing WAKE UP messages.
# WAKE_UP_USER_IDS=123456789012345678,987654321098765432
# WAKE_UP_MESSAGE=WAKE UP
# WAKE_UP_DELETE_AFTER_MS=0
# WAKE_UP_CHANCE_PERCENT=4
# WAKE_UP_TIMEZONE=America/New_York
# WAKE_UP_ALLOWED_HOURS=0-23
